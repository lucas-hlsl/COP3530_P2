{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build C++",
            "command": "g++",
            "args": [
                "-g",
                "src/main.cpp",
                "-o",
                "bin/main.exe",
                "-I", 
                "glfw/include",
                "-L", 
                "glfw/lib-mingw-w64",
                "-lglfw3",
                "-lopengl32",
                "-lgdi32"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}